OPENAI_API_KEY=
# Optional public browser key for detailed satellite imagery. Restrict allowed origins in MapTiler.
# Without it, Satellite uses the key-free EOxCloudless 2016 overview.
NEXT_PUBLIC_MAPTILER_KEY=
OPENAI_MODEL=gpt-6-luna
# FastAPI teaching service (defaults to local port 8000). Keep this server-side.
AI_SERVICE_URL=
# Shared private token on both services when hosting FastAPI.
AI_SERVICE_TOKEN=
KNOWLEDGE_API_URL=
APP_ORIGIN=http://127.0.0.1:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
