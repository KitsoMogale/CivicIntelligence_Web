{
  "name": "civic-intelligence-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "test:canvas": "node scripts/canvas-browser-test.mjs",
    "dev:api": "backend/.venv/Scripts/python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "format": "prettier --write app components lib tests scripts",
    "format:check": "prettier --check app components lib tests scripts",
    "data:check": "node --import tsx scripts/data-review.ts",
    "data:release": "node --import tsx scripts/data-review.ts --release",
    "data:apply": "node --import tsx scripts/data-review.ts --apply",
    "build:verify": "node scripts/build-verify.mjs",
    "start:verify": "node scripts/start-verify.mjs",
    "verify": "npm run data:check && npm run typecheck && npm test && npm run build",
    "test:api": "backend/.venv/Scripts/python.exe -m pytest backend/test_api.py"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "cytoscape": "^3.33.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.12.0",
    "next": "^16.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/geojson": "^7946.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "^1.56.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
